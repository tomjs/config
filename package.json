    "@tomjs/prettier": "workspace:^",
    "@tomjs/stylelint": "workspace:*",
    "@tomjs/tsconfig": "workspace:^",
    "@types/node": "^20.19.37",
    "eslint": "^10.0.3",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "publint": "^0.3.18",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.4.0",
    "tsdown": "^0.21.3",
    "typescript": "^5.9.3"
  }
